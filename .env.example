# Open Data Labs (ODL) API credentials
# Get these from https://dashboard.opendatalabs.com/
ODL_API_BASE_URL=https://api.opendatalabs.com/api/v1
ODL_API_KEY=your_api_key_here
ODL_APP_ID=odl_app_your_id
ODL_ENCRYPTION_SECRET=your_encryption_secret_here

# App URL
APP_URL=http://localhost:3000

# Vana Connect URL (for the two-tab flow)
NEXT_PUBLIC_VANA_CONNECT_OPENING_URL=https://app.vana.org/connect/opening

# Network: moksha (testnet) or mainnet
VANA_NETWORK=moksha

# Mode: sample (dev with fake data) or live (real data, requires ODL keys)
VANA_MODE=sample
